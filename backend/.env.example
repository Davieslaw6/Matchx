# Copy to .env (never commit .env)
DATABASE_URL=sqlite:///./footy.db
FOOTBALL_DATA_API_KEY=            # free key from football-data.org
ACCESS_TOKEN=                     # set a long random string; if empty only localhost can call the API
ENABLED_LEAGUES=PL,PD,SA,BL1,FL1
HTTP_TIMEOUT_S=10
MAX_RETRIES=2
CACHE_TTL_S=300
MIN_SECONDS_BETWEEN_REQUESTS=6.5  # free tier: 10 calls/min
HALF_LIFE_DAYS=365
STALE_AFTER_HOURS=48

# --- second data provider (selectable at runtime) ---
DATA_PROVIDER=football-data.org   # default; switch anytime via PUT /api/provider
API_FOOTBALL_API_KEY=             # from api-football.com (api-sports.io); free plan ~100 req/day

# --- AI chat provider ---
LLM_PROVIDER=anthropic            # anthropic | openai (any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=                     # optional
