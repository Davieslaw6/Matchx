# Application
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGIN=http://localhost:3000
DEMO_MODE=false
TIMEZONE=Africa/Lagos

# Database: PostgreSQL in production; SQLite is optional for local development.
DATABASE_URL=postgresql+asyncpg://matchx:change-me@localhost:5432/matchx

# Set only after owner CLI provisioning; public bind must fail without owner.
OWNER_EXISTS=false
SESSION_SECRET=replace-with-a-long-random-secret

# Optional server-side provider credentials; never expose to browser.
PROVIDER_API_KEY=
LLM_API_KEY=
